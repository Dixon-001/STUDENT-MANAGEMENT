// fuction for attendance and bonus marks 
function attendance() {
  const days = [true, false];
  for (let i = 0; i < students.length; i++) {
    const att = {
      Monday:    days[Math.floor(Math.random() * days.length)],
      Tuesday:   days[Math.floor(Math.random() * days.length)],
      Wednesday: days[Math.floor(Math.random() * days.length)],
      Thursday:  days[Math.floor(Math.random() * days.length)],
      Friday:    days[Math.floor(Math.random() * days.length)]
    };
    students[i].attendance = att;

    // Score THIS student's attendance
    const values = Object.values(att); // [true, false, true, ...]
    const attendedCount = values.filter(v => v).length;

    let bonus = 0;
    if (attendedCount === 5) bonus += 10;  
    else if (attendedCount >= 3) bonus += 5;  

    const previousScore = students[i].score;   // ← save it first
    students[i].score += bonus;
    console.log(`${students[i].name}: ${attendedCount}/5 → Score: ${bonus}`);
  }
}   

